# Default Node config
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the app (1 behind Caddy/Nginx). Keep 0 if exposed directly.
TRUST_PROXY=0

# Database config (docker-compose starts MongoDB on localhost:27017)
DATABASE_URL="mongodb://localhost:27017/server_db"

# JWT Configuration
# Each secret must be a different random value of 32+ characters: `openssl rand -hex 32`
ACCESS_TOKEN=
# Access tokens are short-lived; refresh tokens (opaque, rotated on every use) last longer
ACCESS_EXPIRES=15m
REFRESH_EXPIRES_DAYS=30
VERIFIED_TOKEN=
RESET_SECRET=
RESET_EXPIRES=15m
FRONT_END_URL=http://localhost:5173
# Comma separated list of allowed origins. Defaults to FRONT_END_URL.
CORS_ORIGINS=

# Email Configuration
APP_USER_EMAIL=
APP_PASSWORD=
# "From" address. Defaults to APP_USER_EMAIL.
MAIL_FROM=

# Cloudinary Configuration
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Swagger Config (docs are disabled in production unless ENABLE_SWAGGER=true)
ENABLE_SWAGGER=
DEVELOPMENT_BASE_URL=http://localhost:5000
PRODUCTION_BASE_URL=

# Social login: set IS_<PROVIDER>_LOGIN=true and fill in its credentials.
# After the provider, the browser is sent here with `?code=` (trade it via
# POST /api/auth/social/exchange) or `?error=`. Defaults to FRONT_END_URL/auth/social/callback
SOCIAL_REDIRECT_URL=

IS_GOOGLE_LOGIN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/social/google/callback

IS_FACEBOOK_LOGIN=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/social/facebook/callback

IS_GITHUB_LOGIN=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/social/github/callback

IS_TWITTER_LOGIN=false
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_CALLBACK_URL=http://localhost:5000/api/auth/social/twitter/callback

IS_LINKEDIN_LOGIN=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/social/linkedin/callback

IS_DISCORD_LOGIN=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:5000/api/auth/social/discord/callback
